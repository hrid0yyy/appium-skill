# Copy to .env (git-ignored) and fill in. Real environment variables override .env values.
# Nothing machine-specific belongs in code. It all lives here or in CI variables.

# --- Appium server (Appium 2.x: no /wd/hub base path) -------------------------
APPIUM_SERVER_URL=http://127.0.0.1:4723
EXPLICIT_WAIT_SECONDS=15
NEW_COMMAND_TIMEOUT_SECONDS=120
ARTIFACTS_DIR=artifacts

# --- Android (UiAutomator2) ---------------------------------------------------
# Pick ONE way to select the device:
#   ANDROID_UDID  = serial from `adb devices -l` (real device or running emulator-5554)
#   ANDROID_AVD   = AVD name from `emulator -list-avds` (Appium boots it)
ANDROID_UDID=
ANDROID_AVD=
ANDROID_AVD_LAUNCH_TIMEOUT_MS=180000

# Pick ONE way to select the app:
#   ANDROID_APP = absolute path to an .apk/.apks on the Appium host
#   ANDROID_APP_PACKAGE + ANDROID_APP_ACTIVITY = app already installed
# Sample app (official Appium ApiDemos): `npm pack android-apidemos` and extract
# package/apks/ApiDemos-debug.apk, then point ANDROID_APP at it.
ANDROID_APP=
ANDROID_APP_PACKAGE=io.appium.android.apis
ANDROID_APP_ACTIVITY=.ApiDemos
ANDROID_APP_WAIT_ACTIVITY=
ANDROID_NO_RESET=false
ANDROID_AUTO_GRANT_PERMISSIONS=true

# --- Windows (Appium Windows driver -> WinAppDriver) --------------------------
# AUMID for UWP apps (Get-StartApps), full .exe path for classic apps, or "Root".
WINDOWS_APP=Microsoft.WindowsCalculator_8wekyb3d8bbwe!App
# Attach to an already-open window instead (hex handle, e.g. 0x1A2B3C). Overrides WINDOWS_APP.
WINDOWS_TOP_LEVEL_WINDOW=
WINDOWS_APP_ARGUMENTS=
WINDOWS_APP_WORKING_DIR=
WINDOWS_CREATE_SESSION_TIMEOUT_MS=30000
WINDOWS_WAIT_FOR_APP_LAUNCH_SECONDS=

# --- Default platform for unmarked tests (android | windows) -----------------
TARGET_PLATFORM=android
